# Copy to .env for local runs; set the same variables on Railway.

# Claude writes each participant's tailored prompt. Without a key the app uses the fixed template prompt.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# The Apps Script bridge (apps-script/Code.gs) deployed as a Web app. Without these the app keeps
# data in memory only (lost on restart) — fine for trying it out.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# AI prompt-writer calls allowed per IP address per hour (0 = no limit).
AI_LIMIT_PER_IP_HOUR=30

PORT=3000
